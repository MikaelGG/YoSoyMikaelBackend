Content-Type: application/json

{
  "meditationName": "Meditación para la Calma y Gratitud",
  "meditationUrlVideo": "https://youtube.com/watch?v=meditacion1",
  "meditationDescription": "Sesión guiada de 20 minutos enfocada en la respiración consciente y activación del centro cardíaco.",
